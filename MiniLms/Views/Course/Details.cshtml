@model MiniLms.Models.Course
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

@{
    ViewData["Title"] = Model.Title + " - Ders Detayları";
}

<div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <strong>Başarılı!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <strong>Hata:</strong> @(TempData["ErrorMessage"] ?? TempData["Error"])
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <section class="page-hero">
        <div class="d-flex align-items-center gap-3">
            <span class="hero-icon"><i class="bi bi-journal-richtext"></i></span>
            <div>
                <h1 class="page-title">@Model.Title</h1>
                <p class="page-subtitle">@Model.Description</p>
            </div>
        </div>
        <span class="badge bg-light text-primary border">@Model.CourseCode</span>
    </section>

    <div class="row">
        <!-- SOL PANEL: Ders İçerikleri -->
        <div class="col-lg-7 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-calendar3-week text-primary"></i> Haftalık Ders İçerikleri</h5>
                </div>
                <div class="card-body bg-light">
                    @if (Model.Lessons != null && Model.Lessons.Any(l => l.Title != "Yüklenen Dokümanlar"))
                    {
                        <div class="accordion" id="lessonsAccordion">
                            @foreach (var lesson in Model.Lessons.Where(l => l.Title != "Yüklenen Dokümanlar").OrderBy(l => l.WeekNumber))
                            {
                                <div class="accordion-item border-0 mb-2 shadow-sm rounded">
                                    <h2 class="accordion-header" id="heading-@lesson.Id">
                                        <button class="accordion-button collapsed fw-bold rounded" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@lesson.Id">
                                            Hafta @lesson.WeekNumber: @lesson.Title
                                        </button>
                                    </h2>
                                    <div id="collapse-@lesson.Id" class="accordion-collapse collapse" data-bs-parent="#lessonsAccordion">
                                        <div class="accordion-body bg-white rounded-bottom">
                                            @if (lesson.Contents != null && lesson.Contents.Any())
                                            {
                                                @foreach (var content in lesson.Contents.OrderBy(c => c.Order))
                                                {
                                                    <div class="content-strip mb-2 p-2 border-start border-3 border-primary bg-light">
                                                        <h6 class="fw-bold text-dark mb-1">@content.Title</h6>
                                                        <p class="small text-muted mb-0">@content.Text</p>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <p class="text-muted small mb-0">Bu haftaya ait henüz alt içerik eklenmemiş.</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <p class="mb-0">Bu kursa ait henüz resmi haftalık müfredat konusu eklenmemiştir.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- SAĞ PANEL: AI Asistanı & Dokümanlar -->
        <div class="col-lg-5">
            <div class="card ai-panel mb-4 shadow-sm border-primary">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-robot"></i> AI Çalışma Asistanı</h5>
                </div>
                <div class="card-body bg-light">
                    
                    <div class="alert alert-info py-2 px-3 mb-3 shadow-sm border-info" style="font-size: 0.85rem;">
                        <i class="bi bi-lightbulb-fill text-warning fs-6"></i> <strong>Farklı bir AI modeli deneyin!</strong><br />
                        Varsayılan olarak okulun Gemini sistemini ücretsiz kullanıyorsunuz. Aşağıdan <strong>ChatGPT</strong> veya <strong>Claude</strong>'u seçerek kendi kişisel API anahtarınızla daha gelişmiş modelleri test edebilirsiniz. Nasıl anahtar alacağınızı bilmiyorsanız, modeli seçtiğinizde belirecek olan eğitim videosunu izleyebilirsiniz!
                    </div>

                    <!-- 🎯 YENİ: ChatGPT Benzeri Scroll Edilebilir Sohbet Penceresi -->
                    <div id="chatWindowContainer" class="p-3 mb-3 border rounded bg-white shadow-sm" style="height: 400px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px;">
                        <div class="text-center text-muted small my-auto" id="chatLoadingState">
                            <i class="bi bi-chat-dots fs-3 d-block mb-2"></i> Sohbet geçmişi yükleniyor...
                        </div>
                    </div>
                    <!-- Quiz Butonu artık chat dışına taşındı -->
                    <div class="text-end mb-3">
                        <button type="button" class="btn btn-sm btn-outline-primary fw-bold btn-quiz-from-summary" style="display: none;">
                            <i class="bi bi-question-circle"></i> Son Özeti Quiz'e Çevir
                        </button>
                    </div>

                    <form id="askAiForm" class="bg-white p-3 border rounded shadow-sm">
                        <input type="hidden" name="courseId" value="@Model.Id" />

                        <div class="row mb-3">
                            <div class="col-12 mb-2">
                                <label class="form-label small fw-bold text-secondary">Kaynak Doküman</label>
                                <select class="form-select form-select-sm bg-light" name="documentId" id="documentIdSelect">
                                    <option value="">Tüm Ders Kaynakları</option>
                                    @if (Model.Documents != null)
                                    {
                                        foreach (var doc in Model.Documents)
                                        {
                                            <option value="@doc.Id">@doc.FileName</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold text-secondary">Yapay Zeka Sağlayıcısı</label>
                                <select class="form-select form-select-sm border-primary" name="provider" id="aiProviderSelect">
                                    <option value="gemini" selected>Google Gemini (Ücretsiz Kurumsal Mod)</option>
                                    <option value="chatgpt">OpenAI ChatGPT (Kişisel Anahtar İle)</option>
                                    <option value="claude">Anthropic Claude (Kişisel Anahtar İle)</option>
                                </select>
                            </div>
                        </div>
                        
                        <!-- Gizli API Key Alanı ve YouTube Eğitim Modülü -->
                        <div id="apiConnectionSection" style="display: none;">
                            <div class="mb-3 p-2 bg-light border border-warning rounded">
                                <label class="form-label small fw-bold text-dark">Kişisel API Anahtarınız <i class="bi bi-key-fill text-warning"></i></label>
                                <input type="password" name="userApiKey" id="userApiKeyInput" class="form-control form-control-sm border-warning" placeholder="sk-..." autocomplete="off" />
                                <small class="text-muted d-block mt-1" style="font-size: 10px;">Gizlilik Uyarısı: Girdiğiniz anahtar sunucuya kaydedilmez, sadece bu oturumdaki istekleriniz için anlık olarak kullanılır.</small>
                            </div>

                            <div id="apiKeyHelpContainer" class="mb-3 p-3 bg-white border border-info rounded shadow-sm">
                                <h6 class="fw-bold text-info mb-2 fs-6" id="helpTitle">API Anahtarı Nasıl Alınır?</h6>
                                <div class="small text-muted mb-3" id="helpSteps" style="line-height: 1.5;"></div>
                                <div class="ratio ratio-16x9 rounded overflow-hidden shadow-sm">
                                    <iframe id="helpVideo" src="" title="YouTube API Key Tutorial" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                                </div>
                            </div>
                        </div>

                        <div class="input-group mt-2">
                            <input type="text" name="question" id="aiQuestionInput" class="form-control" placeholder="Ders içeriklerine dair soru sorun..." required />
                            <button type="submit" id="btnAskAi" class="btn btn-primary fw-bold"><i class="bi bi-send"></i> Sor</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Kaynak Dokümanlar Listesi -->
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-file-earmark-pdf text-danger"></i> Kaynak Dokümanlar</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.Documents != null && Model.Documents.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var doc in Model.Documents)
                            {
                                <div class="list-group-item p-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="text-truncate me-2" style="max-width: 70%;">
                                            <span class="fw-bold text-dark small d-block text-truncate">@doc.FileName</span>
                                            <small class="text-muted" style="font-size: 11px;">⏱️ @doc.UploadedDate.ToString("dd.MM.yyyy HH:mm")</small>
                                        </div>
                                        <a href="@doc.FilePath" target="_blank" class="btn btn-sm btn-outline-dark" title="Görüntüle"><i class="bi bi-box-arrow-up-right"></i> Aç</a>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button type="button" data-id="@doc.Id" class="btn btn-sm btn-outline-primary flex-fill btn-summary fw-bold"><i class="bi bi-card-text"></i> Özetle</button>
                                        <button type="button" data-id="@doc.Id" class="btn btn-sm btn-outline-success flex-fill btn-quiz fw-bold"><i class="bi bi-ui-checks"></i> Quiz Yap</button>

                                        @if (User.IsInRole("Teacher"))
                                        {
                                            <form asp-action="DeleteDocument" method="post" class="d-inline" onsubmit="return confirm('Bu dökümanı silmek istediğinize emin misiniz?');">
                                                <input type="hidden" name="id" value="@doc.Id" />
                                                <input type="hidden" name="courseId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-sm btn-danger" title="Sil"><i class="bi bi-trash"></i></button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4 mb-0 small">Bu kursa henüz harici döküman yüklenmemiş.</p>
                    }
                </div>
            </div>

            <!-- Öğretmen Doküman Yükleme Alanı -->
            @if (User.IsInRole("Teacher"))
            {
                <div class="card mb-4 shadow-sm border-0">
                    <div class="card-header bg-white fw-bold py-3">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-cloud-arrow-up text-primary"></i> Bilgi Havuzuna Doküman Ekle</h5>
                    </div>
                    <div class="card-body bg-light">
                        <form asp-action="UploadDocument" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="courseId" value="@Model.Id" />
                            <div class="mb-3">
                                <label class="form-label small text-muted">Tüm akademik formatları destekler (.pdf, .docx, .pptx, .xlsx, .zip vb.). AI metin okuyabilen formatları otomatik indeksler.</label>
                                <input type="file" name="file" class="form-control form-control-sm border-primary" accept=".pdf,.txt,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip,.rar" required />
                            </div>
                            <button type="submit" class="btn btn-warning btn-sm w-100 fw-bold shadow-sm"><i class="bi bi-upload"></i> Yükle ve İndeksle</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Quiz Modalı (Değişmedi) -->
<div class="modal fade" id="quizModal" tabindex="-1" aria-labelledby="quizModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content quiz-modal">
            <div class="modal-header bg-light">
                <div>
                    <h5 class="modal-title fw-bold text-dark" id="quizModalLabel">Doküman Quiz</h5>
                    <small class="text-muted" id="quizProgressText">Hazırlanıyor...</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div id="quizSetup" class="quiz-setup mb-3">
                    <div class="row g-2 align-items-end">
                        <div class="col-sm-4">
                            <label class="form-label small fw-bold text-secondary">Soru Sayısı</label>
                            <select class="form-select form-select-sm" id="quizQuestionCount">
                                <option value="3">3 soru</option>
                                <option value="5" selected>5 soru</option>
                                <option value="10">10 soru</option>
                            </select>
                        </div>
                        <div class="col-sm-5">
                            <label class="form-label small fw-bold text-secondary">Zorluk</label>
                            <select class="form-select form-select-sm" id="quizDifficulty">
                                <option value="mixed" selected>Karma</option>
                                <option value="easy">Kolay</option>
                                <option value="medium">Orta</option>
                                <option value="hard">Zor</option>
                            </select>
                        </div>
                        <div class="col-sm-3">
                            <button type="button" class="btn btn-primary btn-sm w-100 fw-bold" id="quizStartBtn">Başlat</button>
                        </div>
                    </div>
                </div>

                <div class="progress quiz-progress mb-3" role="progressbar">
                    <div class="progress-bar bg-success" id="quizProgressBar" style="width: 0%"></div>
                </div>

                <div id="quizLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-3 mb-0">Seçili yapay zeka sağlayıcısı quizi hazırlıyor. Lütfen bekleyin...</p>
                </div>

                <div id="quizQuestionArea" class="d-none">
                    <div class="quiz-meta mb-3" id="quizMeta"></div>
                    <h5 class="quiz-question fw-bold text-dark" id="quizQuestionText"></h5>
                    <div id="quizOptions" class="quiz-options mt-3"></div>
                    <div id="quizFeedback" class="quiz-feedback d-none"></div>
                </div>

                <div id="quizResultArea" class="d-none text-center py-4">
                    <div class="quiz-score text-primary fw-bold display-4 mb-2" id="quizScoreText"></div>
                    <p class="text-muted mb-4" id="quizScoreDetail"></p>
                    <div id="quizReview" class="text-start bg-light p-3 rounded border"></div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary fw-bold" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary fw-bold" id="quizNextBtn" disabled>Sonraki Soru</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- 🎯 YENİ: Markdown'ı HTML'e çeviren kütüphane -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

    <script>
        $(document).ready(function () {

            // --- DİNAMİK YOUTUBE EĞİTİM VERİTABANI ---
            const apiGuides = {
                chatgpt: {
                    title: "ChatGPT (OpenAI) API Anahtarı Nasıl Alınır?",
                    steps: "<strong>Adım 1:</strong> <a href='https://platform.openai.com' target='_blank'>platform.openai.com</a> adresine gidin ve giriş yapın.<br><strong>Adım 2:</strong> Sol menüden <em>'API Keys'</em> sekmesine tıklayın.<br><strong>Adım 3:</strong> <em>'Create new secret key'</em> butonuna tıklayın, kopyalayıp yukarıdaki kutuya yapıştırın.",
                    videoUrl: "https://www.youtube.com/embed/CGncYPblQA8?si=MiniLmsTutorial"
                },
                claude: {
                    title: "Claude (Anthropic) API Anahtarı Nasıl Alınır?",
                    steps: "<strong>Adım 1:</strong> <a href='https://console.anthropic.com' target='_blank'>console.anthropic.com</a> adresine gidin ve giriş yapın.<br><strong>Adım 2:</strong> Sol taraftaki yan menüden <em>'API Keys'</em> bağlantısına tıklayın.<br><strong>Adım 3:</strong> <em>'Create Key'</em> diyerek oluşturduğunuz şifreyi kopyalayıp yukarı yapıştırın.",
                    videoUrl: "https://www.youtube.com/embed/nfOFl9RyiWw?si=MiniLmsTutorial"
                }
            };

            $("#aiProviderSelect").change(function() {
                const selectedProvider = $(this).val();
                if (selectedProvider === "gemini") {
                    $("#apiConnectionSection").slideUp(300);
                    $("#userApiKeyInput").val("");
                } else {
                    const guideData = apiGuides[selectedProvider];
                    if(guideData) {
                        $("#helpTitle").html('<i class="bi bi-youtube text-danger"></i> ' + guideData.title);
                        $("#helpSteps").html(guideData.steps);
                        $("#helpVideo").attr("src", guideData.videoUrl);
                    }
                    $("#apiConnectionSection").slideDown(300);
                }
            });

            // 🎯 GÜNCELLENDİ: CHAT UI MANTIĞI & MARKDOWN DESTEĞİ
            const chatWindow = $("#chatWindowContainer");

            // Güvenlik: Marked kütüphanesini sadece temel HTML etiketlerine izin verecek şekilde yapılandır
            marked.setOptions({
                breaks: true,
                gfm: true
            });

            function scrollToBottom() {
                chatWindow.scrollTop(chatWindow[0].scrollHeight);
            }

            function appendChatMessage(role, content) {
                $("#chatLoadingState").remove();

                let isUser = role === 'user';
                let alignment = isUser ? 'text-end' : 'text-start';
                let bgColor = isUser ? 'bg-primary text-white' : 'bg-light border text-dark';
                let icon = isUser ? '<i class="bi bi-person-fill"></i> Sen' : '<i class="bi bi-stars text-warning"></i> AI Asistan';
                let padding = isUser ? 'ms-5' : 'me-5';

                let parsedContent = "";

                if (isUser) {
                    parsedContent = escapeHtml(content);
                } else {
                    // 🎯 YENİ: Yapay Zeka Markdown Temizleyicisi (Rogue Stars & Hashes Fix)
                    let cleanedContent = content
                        // 1. Boşluklu kalınlaştırmaları düzeltir ("** Metin **" -> "**Metin**")
                        .replace(/\*\*\s+/g, '**')
                        .replace(/\s+\*\*/g, '**')
                        // 2. Ters yazılmış başlıkları standart formata çevirir ("**### Başlık**" -> "### **Başlık**")
                        .replace(/\*\*(#{1,6})\s+(.*?)\*\*/g, '$1 **$2**')
                        // 3. Başlıkların sonuna veya başına yanlışlıkla eklenen fazladan liste yıldızlarını (*) temizler
                        .replace(/^(#{1,6}.*?)\s*\*+$/gm, '$1');

                    parsedContent = marked.parse(cleanedContent);
                }

                // (Not: Sohbet baloncukları arasına daha rahat bir görünüm için 'mb-3' boşluğu eklendi)
                let html = `
                    <div class="${alignment} ${padding} mb-3">
                        <div class="small text-muted mb-1">${icon}</div>
                        <div class="d-inline-block p-3 rounded shadow-sm text-start ${bgColor}" style="word-wrap: break-word; overflow-x: auto;">
                            ${parsedContent}
                        </div>
                    </div>
                `;

                chatWindow.append(html);
                scrollToBottom();
            } 

            function appendLoadingIndicator() {
                let id = 'loading-' + Date.now();
                let html = `
                    <div id="${id}" class="text-start me-5">
                        <div class="small text-muted mb-1"><i class="bi bi-stars text-warning"></i> AI Asistan</div>
                        <div class="d-inline-block p-2 rounded bg-light border text-dark">
                            <i class='spinner-grow spinner-grow-sm text-primary'></i> Yanıt hazırlanıyor...
                        </div>
                    </div>
                `;
                chatWindow.append(html);
                scrollToBottom();
                return id;
            }

            $.ajax({
                url: '@Url.Action("GetChatHistory", "AiAssistant")',
                type: 'GET',
                data: { courseId: '@Model.Id' },
                success: function (data) {
                    if (data.success && data.history.length > 0) {
                        $("#chatLoadingState").remove();
                        data.history.forEach(function(msg) {
                            appendChatMessage(msg.role, msg.content);
                        });
                    } else {
                        $("#chatLoadingState").html("<i class='bi bi-chat-dots fs-3 d-block mb-2'></i> Öğrenmeye başlamak için soru sorun.");
                    }
                },
                error: function () {
                    $("#chatLoadingState").html("Geçmiş yüklenemedi.");
                }
            });

            function getAjaxData(baseData) {
                return Object.assign(baseData, {
                    provider: $("#aiProviderSelect").val(),
                    userApiKey: $("#userApiKeyInput").val()
                });
            }

            $("#askAiForm").submit(function (e) {
                e.preventDefault();
                var btn = $("#btnAskAi");
                var question = $("#aiQuestionInput").val();

                if(!question.trim()) return;

                appendChatMessage("user", question);
                $("#aiQuestionInput").val("");
                $(".btn-quiz-from-summary").hide();

                btn.prop("disabled", true);
                let loadingId = appendLoadingIndicator();

                $.ajax({
                    url: '@Url.Action("AskAi", "AiAssistant")',
                    type: 'POST',
                    data: getAjaxData({
                        courseId: '@Model.Id',
                        documentId: $("#documentIdSelect").val(),
                        question: question
                    }),
                    success: function (data) {
                        $("#" + loadingId).remove();
                        if (data.success) {
                            appendChatMessage("model", data.response);
                        } else {
                            appendChatMessage("model", "⚠️ Hata: " + data.response);
                        }
                    },
                    error: function () {
                        $("#" + loadingId).remove();
                        appendChatMessage("model", "⚠️ Ağ veya sunucu hatası meydana geldi!");
                    },
                    complete: function () {
                        btn.prop("disabled", false);
                    }
                });
            });

            $(".btn-summary").click(function () {
                var docId = $(this).data("id");
                currentSummaryDocId = docId;
                $("#documentIdSelect").val(docId);
                $(".btn-quiz-from-summary").hide();

                appendChatMessage("user", "Lütfen bu dokümanı özetle.");
                let loadingId = appendLoadingIndicator();

                $.ajax({
                    url: '@Url.Action("DocumentSummary", "AiAssistant")',
                    type: 'GET',
                    data: getAjaxData({
                        courseId: '@Model.Id',
                        documentId: docId
                    }),
                    success: function (data) {
                        $("#" + loadingId).remove();
                        if (data.success) {
                            appendChatMessage("model", data.response);
                            $(".btn-quiz-from-summary").fadeIn();
                        } else {
                            appendChatMessage("model", "⚠️ " + data.response);
                        }
                    },
                    error: function () {
                        $("#" + loadingId).remove();
                        appendChatMessage("model", "⚠️ Sunucuyla iletişim kurulamadı.");
                    }
                });
            });

            // --- QUIZ YÖNETİMİ ---
            var quizState = { questions: [], currentIndex: 0, answers: [], selectedIndex: null, documentId: null };
            var quizModal = new bootstrap.Modal(document.getElementById("quizModal"));
            var currentSummaryDocId = null;

            $(".btn-quiz-from-summary").click(function() {
                if(currentSummaryDocId) {
                    resetQuizModal();
                    quizState.documentId = currentSummaryDocId;
                    quizModal.show();
                }
            });

            $(".btn-quiz").click(function () {
                var docId = $(this).data("id");
                resetQuizModal();
                quizState.documentId = docId;
                quizModal.show();
            });

            $("#quizStartBtn").click(function () {
                loadQuiz();
            });

            $("#quizNextBtn").click(function () {
                if (quizState.selectedIndex === null) return;
                quizState.answers[quizState.currentIndex] = quizState.selectedIndex;
                if (quizState.currentIndex >= quizState.questions.length - 1) {
                    renderQuizResult();
                    return;
                }
                quizState.currentIndex++;
                renderQuizQuestion();
            });

            function resetQuizModal() {
                quizState = { questions: [], currentIndex: 0, answers: [], selectedIndex: null, documentId: quizState.documentId };
                $("#quizProgressText").text("Ayarları seçin");
                $("#quizProgressBar").css("width", "0%");
                $("#quizSetup").removeClass("d-none");
                $("#quizLoading").addClass("d-none");
                $("#quizQuestionArea").addClass("d-none");
                $("#quizResultArea").addClass("d-none");
                $("#quizNextBtn").prop("disabled", true).text("Sonraki Soru").removeClass("btn-success").addClass("btn-primary");
            }

            function loadQuiz() {
                $("#quizSetup").addClass("d-none");
                $("#quizLoading").removeClass("d-none");
                $("#quizStartBtn").prop("disabled", true);

                $.ajax({
                    url: '@Url.Action("DocumentQuizSession", "AiAssistant")',
                    type: 'GET',
                    data: getAjaxData({
                        courseId: '@Model.Id',
                        documentId: quizState.documentId,
                        questionCount: $("#quizQuestionCount").val(),
                        difficulty: $("#quizDifficulty").val()
                    }),
                    success: function (data) {
                        if (data.success && data.questions && data.questions.length > 0) {
                            quizState.questions = data.questions;
                            quizState.answers = new Array(data.questions.length).fill(null);
                            quizState.currentIndex = 0;
                            renderQuizQuestion();
                        } else {
                            showQuizError(data.response || "Yapay zeka quizi oluşturamadı (API hatası olabilir).");
                        }
                    },
                    error: function () {
                        showQuizError("Teknik ağ hatası meydana geldi.");
                    }
                });
            }

            function renderQuizQuestion() {
                var question = quizState.questions[quizState.currentIndex];
                quizState.selectedIndex = quizState.answers[quizState.currentIndex];
                var progress = ((quizState.currentIndex + 1) / quizState.questions.length) * 100;

                $("#quizLoading").addClass("d-none");
                $("#quizResultArea").addClass("d-none");
                $("#quizQuestionArea").removeClass("d-none");
                $("#quizProgressText").text("Soru " + (quizState.currentIndex + 1) + " / " + quizState.questions.length);
                $("#quizProgressBar").css("width", progress + "%");
                $("#quizQuestionText").text(question.question);
                $("#quizNextBtn")
                    .prop("disabled", quizState.selectedIndex === null)
                    .text(quizState.currentIndex === quizState.questions.length - 1 ? "Quizi Bitir" : "Sonraki Soru")
                    .toggleClass("btn-success", quizState.currentIndex === quizState.questions.length - 1)
                    .toggleClass("btn-primary", quizState.currentIndex !== quizState.questions.length - 1);

                var optionsHtml = "";
                question.options.forEach(function (option, index) {
                    var selectedClass = quizState.selectedIndex === index ? " selected bg-primary text-white border-primary" : " bg-white border";
                    optionsHtml += "<button type='button' class='quiz-option w-100 text-start p-3 mb-2 rounded shadow-sm transition-all" + selectedClass + "' data-index='" + index + "'>";
                    optionsHtml += "<span class='fw-bold me-3 py-1 px-2 rounded-circle bg-light text-dark border'>" + String.fromCharCode(65 + index) + "</span>";
                    optionsHtml += "<span>" + escapeHtml(option) + "</span></button>";
                });
                $("#quizOptions").html(optionsHtml);
            }

            $(document).on("click", ".quiz-option", function () {
                quizState.selectedIndex = parseInt($(this).data("index"));
                $(".quiz-option").removeClass("selected bg-primary text-white border-primary").addClass("bg-white border");
                $(this).removeClass("bg-white").addClass("selected bg-primary text-white border-primary");
                $("#quizNextBtn").prop("disabled", false);
            });

            function renderQuizResult() {
                var score = 0;
                var reviewHtml = "";
                quizState.questions.forEach(function (question, index) {
                    var userAnswer = quizState.answers[index];
                    var isCorrect = userAnswer === question.correctIndex;
                    if (isCorrect) score++;

                    var bgClass = isCorrect ? "bg-success bg-opacity-10 border-success" : "bg-danger bg-opacity-10 border-danger";

                    reviewHtml += "<div class='quiz-review-item p-3 mb-3 border rounded " + bgClass + "'>";
                    reviewHtml += "<strong class='d-block mb-2 text-dark'>" + (index + 1) + ". " + escapeHtml(question.question) + "</strong>";
                    reviewHtml += "<p class='mb-1 small " + (isCorrect ? "text-success" : "text-danger fw-bold") + "'><strong>Senin Cevabın:</strong> " + answerLabel(question, userAnswer) + "</p>";
                    if (!isCorrect) {
                        reviewHtml += "<p class='mb-1 small text-success'><strong>Doğru Cevap:</strong> " + answerLabel(question, question.correctIndex) + "</p>";
                    }
                    reviewHtml += "</div>";
                });

                $("#quizQuestionArea").addClass("d-none");
                $("#quizResultArea").removeClass("d-none");
                $("#quizProgressBar").css("width", "100%");

                var scorePercentage = Math.round((score / quizState.questions.length) * 100);
                $("#quizScoreText").html(score + " / " + quizState.questions.length + " <span class='fs-4 text-muted'>(" + scorePercentage + "%)</span>");
                $("#quizReview").html(reviewHtml);
                $("#quizNextBtn").prop("disabled", true).text("Quiz Tamamlandı");
            }

            function showQuizError(message) {
                $("#quizLoading").addClass("d-none");
                $("#quizResultArea").removeClass("d-none");
                $("#quizScoreText").html("<i class='bi bi-exclamation-triangle text-warning'></i>");
                $("#quizScoreDetail").html("<span class='text-danger fw-bold'>" + message + "</span>");
                $("#quizReview").empty();
            }

            function answerLabel(question, index) {
                if (index === null || index === undefined) return "Boş Bırakıldı";
                return String.fromCharCode(65 + index) + ") " + escapeHtml(question.options[index]);
            }

            function escapeHtml(value) {
                return $("<div>").text(value || "").html();
            }
        });
    </script>
    <style>
        .quiz-option {
            cursor: pointer;
            border-width: 2px !important;
        }

            .quiz-option:hover:not(.selected) {
                background-color: #f8f9fa !important;
                border-color: #0d6efd !important;
            }

        .transition-all {
            transition: all 0.2s ease-in-out;
        }

        /* 🎯 YENİ: Markdown içeriği içindeki öğelerin düzgün görünmesi için CSS */
        .ai-panel .bg-light p:last-child {
            margin-bottom: 0;
        }

        .ai-panel .bg-light ul, .ai-panel .bg-light ol {
            margin-bottom: 0;
            padding-left: 1.2rem;
        }
    </style>
}