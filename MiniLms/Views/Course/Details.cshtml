@model MiniLms.Models.Course
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@inject MiniLms.Data.ApplicationDbContext DbContext

@{
    ViewData["Title"] = Model.Title + " - Ders Detayları";
    var activeProviders = DbContext.AiProviders.Where(p => p.IsActive).ToList();
}

<div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <strong>Başarılı!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <strong>Hata:</strong> @(TempData["ErrorMessage"] ?? TempData["Error"])
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <section class="page-hero">
        <div class="d-flex justify-content-between align-items-start w-100">
            <div class="d-flex align-items-center gap-3">
                <span class="hero-icon"><i class="bi bi-journal-richtext"></i></span>
                <div>
                    <h1 class="page-title mb-1">@Model.Title</h1>
                    <p class="page-subtitle mb-2">@Model.Description</p>
                    <span class="badge bg-light text-primary border">@Model.CourseCode</span>
                </div>
            </div>

            @if (User.IsInRole("Teacher"))
            {
                <div class="text-end mt-2 d-flex flex-column gap-2 flex-md-row">
                    <a asp-controller="Enrollment" asp-action="Manage" asp-route-id="@Model.Id" class="btn btn-light border shadow-sm fw-bold text-primary">
                        <i class="bi bi-people-fill"></i> Sınıfı Yönet
                    </a>
                    <a asp-controller="Analytics" asp-action="StudentInsight" asp-route-userId="B266200571" asp-route-courseId="@Model.Id" class="btn btn-warning shadow-sm fw-bold">
                        <i class="bi bi-robot"></i> Örnek AI Analizi Gör
                    </a>
                </div>
            }
        </div>
    </section>

    <div class="row">
        <!-- SOL PANEL: Ders İçerikleri -->
        <div class="col-lg-7 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-calendar3-week text-primary"></i> Haftalık Ders İçerikleri</h5>
                </div>
                <div class="card-body bg-light">
                    @if (Model.Lessons != null && Model.Lessons.Any(l => l.Title != "Yüklenen Dokümanlar"))
                    {
                        <div class="accordion" id="lessonsAccordion">
                            @foreach (var lesson in Model.Lessons.Where(l => l.Title != "Yüklenen Dokümanlar").OrderBy(l => l.WeekNumber))
                            {
                                <div class="accordion-item border-0 mb-2 shadow-sm rounded">
                                    <h2 class="accordion-header" id="heading-@lesson.Id">
                                        <button class="accordion-button collapsed fw-bold rounded" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@lesson.Id">
                                            Hafta @lesson.WeekNumber: @lesson.Title
                                        </button>
                                    </h2>
                                    <div id="collapse-@lesson.Id" class="accordion-collapse collapse" data-bs-parent="#lessonsAccordion">
                                        <div class="accordion-body bg-white rounded-bottom">
                                            @if (lesson.Contents != null && lesson.Contents.Any())
                                            {
                                                @foreach (var content in lesson.Contents.OrderBy(c => c.Order))
                                                {
                                                    <div class="content-strip mb-2 p-2 border-start border-3 border-primary bg-light">
                                                        <h6 class="fw-bold text-dark mb-1">@content.Title</h6>
                                                        <p class="small text-muted mb-0">@content.Text</p>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <p class="text-muted small mb-0">Bu haftaya ait henüz alt içerik eklenmemiş.</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <p class="mb-0">Bu kursa ait henüz resmi haftalık müfredat konusu eklenmemiştir.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- SAĞ PANEL: AI Asistanı & Dokümanlar -->
        <div class="col-lg-5">
            <div class="card ai-panel mb-4 shadow-sm border-primary">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-robot"></i> AI Çalışma Asistanı</h5>
                </div>
                <div class="card-body bg-light">

                    <div id="chatWindowContainer" class="p-3 mb-3 border rounded bg-white shadow-sm" style="height: 400px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px;">
                        <div class="text-center text-muted small my-auto" id="chatLoadingState">
                            <i class="bi bi-chat-dots fs-3 d-block mb-2"></i> Sohbet geçmişi yükleniyor...
                        </div>
                    </div>

                    <div class="text-end mb-3">
                        <button type="button" class="btn btn-sm btn-outline-primary fw-bold btn-quiz-from-summary" style="display: none;">
                            <i class="bi bi-question-circle"></i> Son Özeti Quiz'e Çevir
                        </button>
                    </div>

                    <form id="askAiForm" class="bg-white p-3 border rounded shadow-sm">
                        <input type="hidden" name="courseId" value="@Model.Id" />

                        <div class="row mb-3">
                            <div class="col-12 mb-2">
                                <label class="form-label small fw-bold text-secondary">Kaynak Doküman</label>
                                <select class="form-select form-select-sm bg-light" name="documentId" id="documentIdSelect">
                                    <option value="">Tüm Ders Kaynakları</option>
                                    @if (Model.Documents != null)
                                    {
                                        foreach (var doc in Model.Documents)
                                        {
                                            <option value="@doc.Id">@doc.FileName</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-12">
                                @if (User.IsInRole("Student"))
                                {
                                    <div class="d-flex justify-content-between align-items-end mb-1">
                                        <label class="form-label small fw-bold text-secondary mb-0">Yapay Zeka Sağlayıcısı</label>
                                    </div>
                                    <select class="form-select form-select-sm border-primary" name="provider" id="aiProviderSelect">
                                        @foreach (var provider in activeProviders)
                                        {
                                            if (provider.ProviderKey.ToLower() == "gemini")
                                            {
                                                <option value="@provider.ProviderKey" selected>@provider.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@provider.ProviderKey">@provider.Name</option>
                                            }
                                        }
                                    </select>

                                    <div id="customApiKeyAlert" class="alert alert-warning mt-2 mb-0 py-2 px-3 small border-warning" style="display: none;">
                                        <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                                        Bu modeli kullanmak için API anahtarı eklemelisiniz.
                                        <a asp-controller="StudentProfile" asp-action="ApiKeys" class="fw-bold text-dark text-decoration-underline ms-1">Buradan Ekleyin <i class="bi bi-arrow-right"></i></a>
                                    </div>
                                }
                                else
                                {
                                    <input type="hidden" name="provider" id="aiProviderSelect" value="gemini" />
                                }
                            </div>

                        </div>

                        <div class="input-group mt-2">
                            <input type="text" name="question" id="aiQuestionInput" class="form-control" placeholder="Ders içeriklerine dair soru sorun..." required />
                            <button type="submit" id="btnAskAi" class="btn btn-primary fw-bold"><i class="bi bi-send"></i> Sor</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Kaynak Dokümanlar Listesi -->
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-file-earmark-pdf text-danger"></i> Kaynak Dokümanlar</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.Documents != null && Model.Documents.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var doc in Model.Documents)
                            {
                                <div class="list-group-item p-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="text-truncate me-2" style="max-width: 70%;">
                                            <span class="fw-bold text-dark small d-block text-truncate">@doc.FileName</span>
                                            <small class="text-muted" style="font-size: 11px;">⏱️ @doc.UploadedDate.ToString("dd.MM.yyyy HH:mm")</small>
                                        </div>
                                        <a href="@doc.FilePath" target="_blank" class="btn btn-sm btn-outline-dark" title="Görüntüle"><i class="bi bi-box-arrow-up-right"></i> Aç</a>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button type="button" data-id="@doc.Id" class="btn btn-sm btn-outline-primary flex-fill btn-summary fw-bold"><i class="bi bi-card-text"></i> Özetle</button>
                                        <button type="button" data-id="@doc.Id" class="btn btn-sm btn-outline-success flex-fill btn-quiz fw-bold"><i class="bi bi-ui-checks"></i> Quiz Yap</button>
                                        <button type="button" data-id="@doc.Id" class="btn btn-sm btn-outline-info flex-fill btn-listen-doc fw-bold"><i class="bi bi-headphones"></i> Dinle</button>

                                        @if (User.IsInRole("Teacher"))
                                        {
                                            <form asp-action="DeleteDocument" method="post" class="d-inline" onsubmit="return confirm('Bu dökümanı silmek istediğinize emin misiniz?');">
                                                <input type="hidden" name="id" value="@doc.Id" />
                                                <input type="hidden" name="courseId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-sm btn-danger" title="Sil"><i class="bi bi-trash"></i></button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4 mb-0 small">Bu kursa henüz harici döküman yüklenmemiş.</p>
                    }
                </div>
            </div>

            <!-- Öğretmen Doküman Yükleme Alanı -->
            @if (User.IsInRole("Teacher"))
            {
                <div class="card mb-4 shadow-sm border-0">
                    <div class="card-header bg-white fw-bold py-3">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-cloud-arrow-up text-primary"></i> Bilgi Havuzuna Doküman Ekle</h5>
                    </div>
                    <div class="card-body bg-light">
                        <form asp-action="UploadDocument" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="courseId" value="@Model.Id" />
                            <div class="mb-3">
                                <label class="form-label small text-muted">Tüm akademik formatları destekler (.pdf, .docx, .pptx, vb.).</label>
                                <input type="file" name="file" class="form-control form-control-sm border-primary" accept=".pdf,.txt,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip,.rar" required />
                            </div>
                            <button type="submit" class="btn btn-warning btn-sm w-100 fw-bold shadow-sm"><i class="bi bi-upload"></i> Yükle ve İndeksle</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Quiz Modalı -->
<div class="modal fade" id="quizModal" tabindex="-1" aria-labelledby="quizModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content quiz-modal">
            <div class="modal-header bg-light">
                <div>
                    <h5 class="modal-title fw-bold text-dark" id="quizModalLabel">Doküman Quiz</h5>
                    <small class="text-muted" id="quizProgressText">Hazırlanıyor...</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div id="quizSetup" class="quiz-setup mb-3">
                    <div class="row g-2 align-items-end">
                        <div class="col-sm-4">
                            <label class="form-label small fw-bold text-secondary">Soru Sayısı</label>
                            <select class="form-select form-select-sm" id="quizQuestionCount">
                                <option value="3">3 soru</option>
                                <option value="5" selected>5 soru</option>
                                <option value="10">10 soru</option>
                            </select>
                        </div>
                        <div class="col-sm-5">
                            <label class="form-label small fw-bold text-secondary">Zorluk</label>
                            <select class="form-select form-select-sm" id="quizDifficulty">
                                <option value="mixed" selected>Karma</option>
                                <option value="easy">Kolay</option>
                                <option value="medium">Orta</option>
                                <option value="hard">Zor</option>
                            </select>
                        </div>
                        <div class="col-sm-3">
                            <button type="button" class="btn btn-primary btn-sm w-100 fw-bold" id="quizStartBtn">Başlat</button>
                        </div>
                    </div>
                </div>

                <div class="progress quiz-progress mb-3" role="progressbar">
                    <div class="progress-bar bg-success" id="quizProgressBar" style="width: 0%"></div>
                </div>

                <div id="quizLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-3 mb-0">Yapay zeka sistemi quizi hazırlıyor. Lütfen bekleyin...</p>
                </div>

                <div id="quizQuestionArea" class="d-none">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="quiz-meta" id="quizMeta"></div>
                        <button type="button" class="btn btn-sm btn-outline-primary fw-bold btn-quiz-audio" id="quizAudioBtn" title="Soruyu ve şıkları sesli oku">
                            <i class="bi bi-volume-up"></i> <span>Sesli Oku</span>
                        </button>
                    </div>
                    <h5 class="quiz-question fw-bold text-dark" id="quizQuestionText"></h5>
                    <div id="quizOptions" class="quiz-options mt-3"></div>
                    <div id="quizFeedback" class="quiz-feedback d-none"></div>
                </div>

                <div id="quizResultArea" class="d-none text-center py-4">
                    <div class="quiz-score text-primary fw-bold display-4 mb-2" id="quizScoreText"></div>
                    <p class="text-muted mb-4" id="quizScoreDetail"></p>
                    <div id="quizReview" class="text-start bg-light p-3 rounded border"></div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary fw-bold" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary fw-bold" id="quizNextBtn" disabled>Sonraki Soru</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

    <script>
        $(document).ready(function () {

            $("#aiProviderSelect").change(function () {
                var selectedProvider = $(this).val();
                if (selectedProvider && selectedProvider !== "gemini") {
                    $("#customApiKeyAlert").slideDown(200);
                } else {
                    $("#customApiKeyAlert").slideUp(200);
                }
            });

            const chatWindow = $("#chatWindowContainer");

            marked.setOptions({
                breaks: true,
                gfm: true
            });

            // --- AUDIO / TEXT-TO-SPEECH (TTS) OKUYUCU (Çoklu Dil & Akıllı Dil Tespiti) ---
            window._activeUtterances = []; // Chrome garbage collection koruması

            const AudioReader = {
                synth: ('speechSynthesis' in window) ? window.speechSynthesis : null,
                activeButton: null,
                voices: [],
                isSpeaking: false,

                init: function () {
                    if (!this.synth) return;
                    this.loadVoices();
                    if (window.speechSynthesis.onvoiceschanged !== undefined) {
                        window.speechSynthesis.onvoiceschanged = () => this.loadVoices();
                    }
                },

                loadVoices: function () {
                    if (!this.synth) return;
                    this.voices = this.synth.getVoices() || [];
                },

                // Metnin dilini (Türkçe, İngilizce, Almanca, Fransızca, İspanyolca, Arapça vb.) otomatik tespit eder
                detectLanguage: function (text) {
                    if (!text) return 'tr-TR';

                    // 1. Karakter Seti Analizi (Arapça, Rusça, Çince, Japonca)
                    if (/[\u0600-\u06FF]/.test(text)) return 'ar-SA';
                    if (/[\u0400-\u04FF]/.test(text)) return 'ru-RU';
                    if (/[\u4E00-\u9FFF]/.test(text)) return 'zh-CN';
                    if (/[\u3040-\u30FF]/.test(text)) return 'ja-JP';

                    const lower = text.toLowerCase();
                    const words = lower.match(/\b[a-zçğıöşüáéíóúàèìòùäëïöüâêîôûñß]+\b/g) || [];

                    // Türkçe skoru (Harf ve sık kullanılan kelimeler)
                    const trLetters = (lower.match(/[çğıöşü]/g) || []).length * 4;
                    const trWords = words.filter(w => ['ve','bir','bu','da','de','ile','için','olan','olarak','var','yok','soru','şıkkı','ders','doküman','cevap','hangisidir','nedir'].includes(w)).length * 3;
                    const trScore = trLetters + trWords;

                    // İngilizce skoru
                    const enScore = words.filter(w => ['the','is','are','was','were','in','of','to','and','with','this','that','which','for','from','what','how','question','option','answer','following','which','why'].includes(w)).length * 3;

                    // Almanca skoru
                    const deScore = words.filter(w => ['der','die','das','und','ist','sind','in','ein','eine','für','nicht','mit','auf','den','dem','frage','antwort'].includes(w)).length * 3 + (lower.match(/[äöüß]/g) || []).length * 3;

                    // Fransızca skoru
                    const frScore = words.filter(w => ['le','la','les','et','est','sont','dans','un','une','pour','avec','sur','que','qui','ce','cette','question'].includes(w)).length * 3 + (lower.match(/[éèêàùç]/g) || []).length * 2;

                    // İspanyolca skoru
                    const esScore = words.filter(w => ['el','la','los','las','y','es','son','en','un','una','para','con','por','que','del','al','pregunta','opcion'].includes(w)).length * 3 + (lower.match(/[áéíóúñ¿¡]/g) || []).length * 3;

                    const scores = [
                        { lang: 'tr-TR', score: trScore },
                        { lang: 'en-US', score: enScore },
                        { lang: 'de-DE', score: deScore },
                        { lang: 'fr-FR', score: frScore },
                        { lang: 'es-ES', score: esScore }
                    ];

                    scores.sort((a, b) => b.score - a.score);

                    if (scores[0].score > 0) {
                        return scores[0].lang;
                    }

                    // Varsayılan dil
                    if (/[çğıöşüÇĞİÖŞÜ]/.test(text)) return 'tr-TR';
                    return navigator.language || 'tr-TR';
                },

                // Tespit edilen dile göre en doğal / uygun sesi seçer
                getPreferredVoiceForLang: function (langCode) {
                    if (!this.voices || this.voices.length === 0) {
                        this.loadVoices();
                    }
                    if (!this.voices || this.voices.length === 0) return null;

                    const prefix = langCode.split('-')[0].toLowerCase();

                    // 1. O dil için doğal/neural ses ara (Google, Natural, Neural, Online)
                    let voice = this.voices.find(v => v.lang.toLowerCase().startsWith(prefix) && 
                        (v.name.includes('Google') || v.name.includes('Natural') || v.name.includes('Neural') || 
                         v.name.includes('Tolga') || v.name.includes('Ahmet') || v.name.includes('Emel') || 
                         v.name.includes('Jenny') || v.name.includes('Guy') || v.name.includes('Aria')));
                    
                    // 2. O dile ait herhangi bir ses ara
                    if (!voice) {
                        voice = this.voices.find(v => v.lang.toLowerCase().startsWith(prefix));
                    }

                    // 3. Varsayılan sistem sesine dön
                    if (!voice) {
                        voice = this.voices.find(v => v.default) || this.voices[0];
                    }
                    return voice;
                },

                // Quiz okumalarında soru ve şık etiketlerini dile göre belirler
                getQuizPrefixes: function (langCode) {
                    const prefix = (langCode || 'tr').split('-')[0].toLowerCase();
                    switch(prefix) {
                        case 'en':
                            return {
                                question: (num) => "Question " + num + ": ",
                                option: (letter) => "Option " + letter + ": "
                            };
                        case 'de':
                            return {
                                question: (num) => "Frage " + num + ": ",
                                option: (letter) => "Option " + letter + ": "
                            };
                        case 'fr':
                            return {
                                question: (num) => "Question " + num + ": ",
                                option: (letter) => "Option " + letter + ": "
                            };
                        case 'es':
                            return {
                                question: (num) => "Pregunta " + num + ": ",
                                option: (letter) => "Opción " + letter + ": "
                            };
                        case 'ar':
                            return {
                                question: (num) => "السؤال " + num + ": ",
                                option: (letter) => "الخيار " + letter + ": "
                            };
                        case 'tr':
                        default:
                            return {
                                question: (num) => "Soru " + num + ": ",
                                option: (letter) => letter + " şıkkı: "
                            };
                    }
                },

                cleanTextForSpeech: function (text) {
                    if (!text) return "";
                    return text
                        .replace(/```[\s\S]*?```/g, ' Code snippet skipped. ')
                        .replace(/`([^`]+)`/g, '$1')
                        .replace(/\[([^\]]+)\]\([^\)]+\)/g, '$1')
                        .replace(/#{1,6}\s*/g, '')
                        .replace(/(\*\*|__)(.*?)\1/g, '$2')
                        .replace(/(\*|_)(.*?)\1/g, '$2')
                        .replace(/^\s*[-*+]\s+/gm, '')
                        .replace(/^\s*\d+\.\s+/gm, '')
                        .replace(/>\s*/g, '')
                        .replace(/<[^>]*>/g, '')
                        .replace(/&nbsp;/g, ' ')
                        .replace(/\s+/g, ' ')
                        .trim();
                },

                // Uzun metinleri cümlelere bölerek Chrome'un durmasını önler
                splitIntoSentences: function (text) {
                    if (!text) return [];
                    const sentences = text.match(/[^.!?\n]+[.!?\n]+/g) || [text];
                    return sentences.map(s => s.trim()).filter(s => s.length > 0);
                },

                speak: function (text, btnElement, onComplete, explicitLang) {
                    if (!this.synth) {
                        alert('Tarayıcınız sesli okuma özelliğini desteklemiyor.');
                        return;
                    }

                    // Aynı butona tekrar tıklandıysa durdur
                    if (this.isSpeaking && this.activeButton === btnElement) {
                        this.stop();
                        return;
                    }

                    this.stop();

                    const clean = this.cleanTextForSpeech(text);
                    if (!clean) return;

                    const sentences = this.splitIntoSentences(clean);
                    if (sentences.length === 0) return;

                    this.loadVoices();

                    // Dil tespiti (veya belirtilen dil)
                    const detectedLang = explicitLang || this.detectLanguage(clean);
                    const voice = this.getPreferredVoiceForLang(detectedLang);
                    const voiceLang = (voice && voice.lang) ? voice.lang : detectedLang;

                    this.activeButton = btnElement;
                    this.isSpeaking = true;
                    this.setButtonState(btnElement, true);

                    window._activeUtterances = [];

                    // Chrome kilitlenmesini çözmek için unpause et
                    if (this.synth.paused) {
                        this.synth.resume();
                    }

                    let index = 0;
                    const speakNext = () => {
                        if (!this.isSpeaking || index >= sentences.length) {
                            this.stop();
                            if (onComplete) onComplete();
                            return;
                        }

                        const sentence = sentences[index++];
                        const utterance = new SpeechSynthesisUtterance(sentence);
                        utterance.volume = 1.0;
                        utterance.rate = 1.0;
                        utterance.pitch = 1.0;

                        if (voice) {
                            utterance.voice = voice;
                            utterance.lang = voice.lang;
                        } else {
                            utterance.lang = voiceLang;
                        }

                        utterance.onend = () => {
                            if (this.isSpeaking) {
                                speakNext();
                            }
                        };

                        utterance.onerror = (e) => {
                            console.warn('TTS utterance error:', e);
                            if (this.isSpeaking) {
                                speakNext();
                            }
                        };

                        window._activeUtterances.push(utterance);
                        this.synth.speak(utterance);
                    };

                    speakNext();
                },

                stop: function () {
                    this.isSpeaking = false;
                    window._activeUtterances = [];
                    if (this.synth) {
                        this.synth.cancel();
                    }
                    if (this.activeButton) {
                        this.setButtonState(this.activeButton, false);
                        this.activeButton = null;
                    }
                },

                setButtonState: function (btn, isSpeaking) {
                    if (!btn) return;
                    const $btn = $(btn);
                    if (isSpeaking) {
                        $btn.addClass('speaking btn-danger text-white').removeClass('btn-outline-primary btn-outline-secondary btn-outline-info');
                        $btn.find('i').attr('class', 'bi bi-stop-fill');
                        $btn.find('span').text('Durdur');
                    } else {
                        $btn.removeClass('speaking btn-danger text-white');
                        if ($btn.hasClass('btn-quiz-audio')) {
                            $btn.addClass('btn-outline-primary');
                            $btn.find('span').text('Sesli Oku');
                        } else if ($btn.hasClass('btn-listen-doc')) {
                            $btn.addClass('btn-outline-info');
                            $btn.find('span').text('Dinle');
                        } else {
                            $btn.addClass('btn-outline-secondary');
                            $btn.find('span').text('Dinle');
                        }
                        $btn.find('i').attr('class', 'bi bi-volume-up');
                    }
                }
            };

            AudioReader.init();

            function scrollToBottom() {
                chatWindow.scrollTop(chatWindow[0].scrollHeight);
            }

            function appendChatMessage(role, content) {
                $("#chatLoadingState").remove();

                let isUser = role === 'user';
                let alignment = isUser ? 'text-end' : 'text-start';
                let bgColor = isUser ? 'bg-primary text-white' : 'bg-light border text-dark';
                let icon = isUser ? '<i class="bi bi-person-fill"></i> Sen' : '<i class="bi bi-stars text-warning"></i> AI Asistan';
                let padding = isUser ? 'ms-5' : 'me-5';

                let parsedContent = "";

                if (isUser) {
                    parsedContent = escapeHtml(content);
                } else {
                    let cleanedContent = content
                        .replace(/\*\*\s+/g, '**')
                        .replace(/\s+\*\*/g, '**')
                        .replace(/\*\*(#{1,6})\s+(.*?)\*\*/g, '$1 **$2**')
                        .replace(/^(#{1,6}.*?)\s*\*+$/gm, '$1');

                    parsedContent = marked.parse(cleanedContent);
                }

                let audioToolbar = "";
                if (!isUser) {
                    audioToolbar = `
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-secondary border-opacity-10">
                            <small class="text-muted" style="font-size: 11px;"><i class="bi bi-robot"></i> AI Yanıtı</small>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 btn-speak-message" title="Sesli Dinle">
                                <i class="bi bi-volume-up"></i> <span>Dinle</span>
                            </button>
                        </div>
                    `;
                }

                let html = `
                    <div class="${alignment} ${padding} mb-3 chat-bubble-container">
                        <div class="small text-muted mb-1">${icon}</div>
                        <div class="d-inline-block p-3 rounded shadow-sm text-start ${bgColor}" style="word-wrap: break-word; overflow-x: auto; max-width: 90%;">
                            <div class="chat-message-content">${parsedContent}</div>
                            ${audioToolbar}
                        </div>
                    </div>
                `;

                chatWindow.append(html);
                scrollToBottom();
            }

            // Mesaj balonlarındaki "Dinle" butonu
            $(document).on("click", ".btn-speak-message", function () {
                var messageEl = $(this).closest(".chat-bubble-container").find(".chat-message-content");
                var textToRead = messageEl.text();
                AudioReader.speak(textToRead, this);
            });

            function appendLoadingIndicator() {
                let id = 'loading-' + Date.now();
                let html = `
                    <div id="${id}" class="text-start me-5">
                        <div class="small text-muted mb-1"><i class="bi bi-stars text-warning"></i> AI Asistan</div>
                        <div class="d-inline-block p-2 rounded bg-light border text-dark">
                            <i class='spinner-grow spinner-grow-sm text-primary'></i> Yanıt hazırlanıyor...
                        </div>
                    </div>
                `;
                chatWindow.append(html);
                scrollToBottom();
                return id;
            }

            $.ajax({
                url: '@Url.Action("GetChatHistory", "AiAssistant")',
                type: 'GET',
                data: { courseId: '@Model.Id' },
                success: function (data) {
                    if (data.success && data.history.length > 0) {
                        $("#chatLoadingState").remove();
                        data.history.forEach(function(msg) {
                            appendChatMessage(msg.role, msg.content);
                        });
                    } else {
                        $("#chatLoadingState").html("<i class='bi bi-chat-dots fs-3 d-block mb-2'></i> Öğrenmeye başlamak için soru sorun.");
                    }
                },
                error: function () {
                    $("#chatLoadingState").html("Geçmiş yüklenemedi.");
                }
            });

            function getAjaxData(baseData) {
                return Object.assign(baseData, {
                    provider: $("#aiProviderSelect").val() || "gemini"
                });
            }

            $("#askAiForm").submit(function (e) {
                e.preventDefault();
                var btn = $("#btnAskAi");
                var question = $("#aiQuestionInput").val();

                if(!question.trim()) return;

                appendChatMessage("user", question);
                $("#aiQuestionInput").val("");
                $(".btn-quiz-from-summary").hide();

                btn.prop("disabled", true);
                let loadingId = appendLoadingIndicator();

                $.ajax({
                    url: '@Url.Action("AskAi", "AiAssistant")',
                    type: 'POST',
                    data: getAjaxData({
                        courseId: '@Model.Id',
                        documentId: $("#documentIdSelect").val(),
                        question: question
                    }),
                    success: function (data) {
                        $("#" + loadingId).remove();
                        if (data.success) {
                            appendChatMessage("model", data.response);
                        } else {
                            appendChatMessage("model", data.response);
                        }
                    },
                    error: function () {
                        $("#" + loadingId).remove();
                        appendChatMessage("model", "⚠️ Ağ veya sunucu hatası meydana geldi!");
                    },
                    complete: function () {
                        btn.prop("disabled", false);
                    }
                });
            });

            $(".btn-summary").click(function () {
                var docId = $(this).data("id");
                currentSummaryDocId = docId;
                $("#documentIdSelect").val(docId);
                $(".btn-quiz-from-summary").hide();

                appendChatMessage("user", "Lütfen bu dokümanı özetle.");
                let loadingId = appendLoadingIndicator();

                $.ajax({
                    url: '@Url.Action("DocumentSummary", "AiAssistant")',
                    type: 'GET',
                    data: getAjaxData({
                        courseId: '@Model.Id',
                        documentId: docId
                    }),
                    success: function (data) {
                        $("#" + loadingId).remove();
                        if (data.success) {
                            appendChatMessage("model", data.response);
                            $(".btn-quiz-from-summary").fadeIn();
                        } else {
                            appendChatMessage("model", data.response);
                        }
                    },
                    error: function () {
                        $("#" + loadingId).remove();
                        appendChatMessage("model", "⚠️ Sunucuyla iletişim kurulamadı.");
                    }
                });
            });

            // 🎯 YENİ: Dokümanı Sesli Özetle ve Oku
            $(".btn-listen-doc").click(function () {
                var docId = $(this).data("id");
                var btn = this;
                currentSummaryDocId = docId;
                $("#documentIdSelect").val(docId);
                $(".btn-quiz-from-summary").hide();

                appendChatMessage("user", "Lütfen bu dokümanı özetle ve sesli dinlet.");
                let loadingId = appendLoadingIndicator();

                $.ajax({
                    url: '@Url.Action("DocumentSummary", "AiAssistant")',
                    type: 'GET',
                    data: getAjaxData({
                        courseId: '@Model.Id',
                        documentId: docId
                    }),
                    success: function (data) {
                        $("#" + loadingId).remove();
                        if (data.success) {
                            appendChatMessage("model", data.response);
                            $(".btn-quiz-from-summary").fadeIn();
                            // Otomatik olarak özeti sesli oku
                            AudioReader.speak(data.response, btn);
                        } else {
                            appendChatMessage("model", data.response);
                        }
                    },
                    error: function () {
                        $("#" + loadingId).remove();
                        appendChatMessage("model", "⚠️ Sunucuyla iletişim kurulamadı.");
                    }
                });
            });

            // --- QUIZ YÖNETİMİ ---
            var quizState = { questions: [], currentIndex: 0, answers: [], selectedIndex: null, documentId: null };
            var quizModal = new bootstrap.Modal(document.getElementById("quizModal"));
            var currentSummaryDocId = null;

            $('#quizModal').on('hidden.bs.modal', function () {
                AudioReader.stop();
            });

            $(".btn-quiz-from-summary").click(function() {
                if(currentSummaryDocId) {
                    resetQuizModal();
                    quizState.documentId = currentSummaryDocId;
                    quizModal.show();
                }
            });

            $(".btn-quiz").click(function () {
                var docId = $(this).data("id");
                resetQuizModal();
                quizState.documentId = docId;
                quizModal.show();
            });

            $("#quizStartBtn").click(function () {
                loadQuiz();
            });

            $("#quizNextBtn").click(function () {
                if (quizState.selectedIndex === null) return;
                AudioReader.stop();
                quizState.answers[quizState.currentIndex] = quizState.selectedIndex;
                if (quizState.currentIndex >= quizState.questions.length - 1) {
                    renderQuizResult();
                    return;
                }
                quizState.currentIndex++;
                renderQuizQuestion();
            });

            // Quiz sorusunu ve şıklarını metnin diline göre otomatik sesli oku
            $("#quizAudioBtn").click(function () {
                var q = quizState.questions[quizState.currentIndex];
                if (!q) return;

                var detectedLang = AudioReader.detectLanguage(q.question);
                var prefixes = AudioReader.getQuizPrefixes(detectedLang);

                var textToRead = prefixes.question(quizState.currentIndex + 1) + q.question + ". ";
                if (q.options && q.options.length > 0) {
                    q.options.forEach(function (opt, i) {
                        textToRead += prefixes.option(String.fromCharCode(65 + i)) + opt + ". ";
                    });
                }
                AudioReader.speak(textToRead, this, null, detectedLang);
            });

            function resetQuizModal() {
                AudioReader.stop();
                quizState = { questions: [], currentIndex: 0, answers: [], selectedIndex: null, documentId: quizState.documentId };
                $("#quizProgressText").text("Ayarları seçin");
                $("#quizProgressBar").css("width", "0%");
                $("#quizSetup").removeClass("d-none");
                $("#quizLoading").addClass("d-none");
                $("#quizQuestionArea").addClass("d-none");
                $("#quizResultArea").addClass("d-none");
                $("#quizNextBtn").prop("disabled", true).text("Sonraki Soru").removeClass("btn-success").addClass("btn-primary");
            }

            function loadQuiz() {
                AudioReader.stop();
                $("#quizSetup").addClass("d-none");
                $("#quizLoading").removeClass("d-none");
                $("#quizStartBtn").prop("disabled", true);

                $.ajax({
                    url: '@Url.Action("DocumentQuizSession", "AiAssistant")',
                    type: 'GET',
                    data: getAjaxData({
                        courseId: '@Model.Id',
                        documentId: quizState.documentId,
                        questionCount: $("#quizQuestionCount").val(),
                        difficulty: $("#quizDifficulty").val()
                    }),
                    success: function (data) {
                        if (data.success && data.questions && data.questions.length > 0) {
                            quizState.questions = data.questions;
                            quizState.answers = new Array(data.questions.length).fill(null);
                            quizState.currentIndex = 0;
                            renderQuizQuestion();
                        } else {
                            showQuizError(data.response || "Yapay zeka quizi oluşturamadı (API hatası olabilir).");
                        }
                    },
                    error: function () {
                        showQuizError("Teknik ağ hatası meydana geldi.");
                    }
                });
            }

            function renderQuizQuestion() {
                AudioReader.stop();
                var question = quizState.questions[quizState.currentIndex];
                quizState.selectedIndex = quizState.answers[quizState.currentIndex];
                var progress = ((quizState.currentIndex + 1) / quizState.questions.length) * 100;

                $("#quizLoading").addClass("d-none");
                $("#quizResultArea").addClass("d-none");
                $("#quizQuestionArea").removeClass("d-none");
                $("#quizProgressText").text("Soru " + (quizState.currentIndex + 1) + " / " + quizState.questions.length);
                $("#quizProgressBar").css("width", progress + "%");
                $("#quizQuestionText").text(question.question);
                $("#quizNextBtn")
                    .prop("disabled", quizState.selectedIndex === null)
                    .text(quizState.currentIndex === quizState.questions.length - 1 ? "Quizi Bitir" : "Sonraki Soru")
                    .toggleClass("btn-success", quizState.currentIndex === quizState.questions.length - 1)
                    .toggleClass("btn-primary", quizState.currentIndex !== quizState.questions.length - 1);

                var optionsHtml = "";
                question.options.forEach(function (option, index) {
                    var selectedClass = quizState.selectedIndex === index ? " selected" : "";
                    optionsHtml += "<button type='button' class='quiz-option" + selectedClass + "' data-index='" + index + "'>";
                    optionsHtml += "<span class='quiz-option-badge'>" + String.fromCharCode(65 + index) + "</span>";
                    optionsHtml += "<span class='quiz-option-text'>" + escapeHtml(option) + "</span>";
                    optionsHtml += "</button>";
                });
                $("#quizOptions").html(optionsHtml);
            }

            $(document).on("click", ".quiz-option", function () {
                quizState.selectedIndex = parseInt($(this).data("index"));
                $(".quiz-option").removeClass("selected");
                $(this).addClass("selected");
                $("#quizNextBtn").prop("disabled", false);
            });

            function renderQuizResult() {
                AudioReader.stop();
                var score = 0;
                var reviewHtml = "";
                quizState.questions.forEach(function (question, index) {
                    var userAnswer = quizState.answers[index];
                    var isCorrect = userAnswer === question.correctIndex;
                    if (isCorrect) score++;

                    var bgClass = isCorrect ? "bg-success bg-opacity-10 border-success" : "bg-danger bg-opacity-10 border-danger";

                    reviewHtml += "<div class='quiz-review-item p-3 mb-3 border rounded " + bgClass + "'>";
                    reviewHtml += "<strong class='d-block mb-2 text-dark'>" + (index + 1) + ". " + escapeHtml(question.question) + "</strong>";
                    reviewHtml += "<p class='mb-1 small " + (isCorrect ? "text-success" : "text-danger fw-bold") + "'><strong>Senin Cevabın:</strong> " + answerLabel(question, userAnswer) + "</p>";
                    if (!isCorrect) {
                        reviewHtml += "<p class='mb-1 small text-success'><strong>Doğru Cevap:</strong> " + answerLabel(question, question.correctIndex) + "</p>";
                    }
                    reviewHtml += "</div>";
                });

                $("#quizQuestionArea").addClass("d-none");
                $("#quizResultArea").removeClass("d-none");
                $("#quizProgressBar").css("width", "100%");

                var scorePercentage = Math.round((score / quizState.questions.length) * 100);
                $("#quizScoreText").html(score + " / " + quizState.questions.length + " <span class='fs-4 text-muted'>(" + scorePercentage + "%)</span>");
                $("#quizReview").html(reviewHtml);
                $("#quizNextBtn").prop("disabled", true).text("Quiz Tamamlandı");
            }

            function showQuizError(message) {
                AudioReader.stop();
                $("#quizLoading").addClass("d-none");
                $("#quizResultArea").removeClass("d-none");
                $("#quizScoreText").html("<i class='bi bi-exclamation-triangle text-warning'></i>");
                $("#quizScoreDetail").html("<span class='text-danger fw-bold'>" + message + "</span>");
                $("#quizReview").empty();
            }

            function answerLabel(question, index) {
                if (index === null || index === undefined) return "Boş Bırakıldı";
                return String.fromCharCode(65 + index) + ") " + escapeHtml(question.options[index]);
            }

            function escapeHtml(value) {
                return $("<div>").text(value || "").html();
            }
        });
    </script>
    <style>
        .ai-panel .bg-light p:last-child {
            margin-bottom: 0;
        }

        .ai-panel .bg-light ul, .ai-panel .bg-light ol {
            margin-bottom: 0;
            padding-left: 1.2rem;
        }
    </style>
}