@model MiniLms.Models.Course
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

@{
    ViewData["Title"] = Model.Title + " - Ders Detayları";

    // Read the dynamic models from appsettings.json
    var supportedModels = Configuration.GetSection("AiServices:Gemini:SupportedModels").Get<string[]>()
                          ?? new[] { "gemini-2.5-flash", "gemini-1.5-flash" };
    var defaultModel = Configuration["AiServices:Gemini:DefaultModel"] ?? "gemini-2.5-flash";
}

<div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <strong>Başarılı!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <strong>Hata:</strong> @(TempData["ErrorMessage"] ?? TempData["Error"])
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <section class="page-hero">
        <div class="d-flex align-items-center gap-3">
            <span class="hero-icon"><i class="bi bi-journal-richtext"></i></span>
            <div>
                <h1 class="page-title">@Model.Title</h1>
                <p class="page-subtitle">@Model.Description</p>
            </div>
        </div>
        <span class="badge bg-light text-primary border">@Model.CourseCode</span>
    </section>

    <div class="row">
        <div class="col-lg-7 mb-4">
            <div class="card h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-calendar3-week text-primary"></i> Haftalık Ders İçerikleri</h5>
                </div>
                <div class="card-body">
                    @if (Model.Lessons != null && Model.Lessons.Any(l => l.Title != "Yüklenen Dokümanlar"))
                    {
                        <div class="accordion" id="lessonsAccordion">
                            @foreach (var lesson in Model.Lessons.Where(l => l.Title != "Yüklenen Dokümanlar").OrderBy(l => l.WeekNumber))
                            {
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="heading-@lesson.Id">
                                        <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@lesson.Id">
                                            Hafta @lesson.WeekNumber: @lesson.Title
                                        </button>
                                    </h2>
                                    <div id="collapse-@lesson.Id" class="accordion-collapse collapse" data-bs-parent="#lessonsAccordion">
                                        <div class="accordion-body bg-white">
                                            @if (lesson.Contents != null && lesson.Contents.Any())
                                            {
                                                @foreach (var content in lesson.Contents.OrderBy(c => c.Order))
                                                {
                                                    <div class="content-strip mb-2">
                                                        <h6 class="fw-bold text-dark mb-1">@content.Title</h6>
                                                        <p class="small text-muted mb-0">@content.Text</p>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <p class="text-muted small mb-0">Bu haftaya ait henüz alt içerik eklenmemiş.</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <p class="mb-0">Bu kursa ait henüz resmi haftalık müfredat konusu eklenmemiştir.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card ai-panel mb-4 shadow-sm border-primary">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-robot"></i> AI Çalışma Asistanı</h5>
                </div>
                <div class="card-body bg-light">
                    <p class="small text-muted mb-3">
                        Ders içeriklerini analiz edin, özet çıkarın veya seçtiğiniz yapay zeka modeliyle etkileşimli quizler oluşturun.
                    </p>

                    <div id="aiResponseContainer" class="p-3 mb-3 border border-2 rounded bg-white shadow-sm d-none">
                        <span class="fw-bold text-primary d-block mb-2"><i class="bi bi-stars"></i> Asistan Yanıtı:</span>
                        <div id="aiResponseText" class="small text-dark" style="white-space: pre-wrap; line-height: 1.6;"></div>
                        <hr />
                        <div class="text-end mt-2">
                            <button type="button" class="btn btn-sm btn-outline-primary fw-bold btn-quiz-from-summary" style="display: none;">
                                <i class="bi bi-question-circle"></i> Bu Özeti Quiz'e Çevir
                            </button>
                        </div>
                    </div>

                    <form id="askAiForm" class="bg-white p-3 border rounded">
                        <input type="hidden" name="courseId" value="@Model.Id" />

                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-bold text-secondary">Kaynak Doküman</label>
                                <select class="form-select form-select-sm" name="documentId" id="documentIdSelect">
                                    <option value="">Tüm Ders Kaynakları</option>
                                    @if (Model.Documents != null)
                                    {
                                        foreach (var doc in Model.Documents)
                                        {
                                            <option value="@doc.Id">@doc.FileName</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold text-secondary">Yapay Zeka Modeli</label>
                                <select class="form-select form-select-sm" name="modelName" id="aiModelSelect">
                                    @foreach (var modelName in supportedModels)
                                    {
                                        if (modelName == defaultModel)
                                        {
                                            <option value="@modelName" selected>@modelName (Varsayılan)</option>
                                        }
                                        else
                                        {
                                            <option value="@modelName">@modelName</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="input-group">
                            <input type="text" name="question" id="aiQuestionInput" class="form-control" placeholder="Ders içeriklerine dair soru sorun..." required />
                            <button type="submit" id="btnAskAi" class="btn btn-primary fw-bold"><i class="bi bi-send"></i> Sor</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-file-earmark-pdf text-danger"></i> Kaynak Dokümanlar</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.Documents != null && Model.Documents.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var doc in Model.Documents)
                            {
                                <div class="list-group-item p-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="text-truncate me-2" style="max-width: 70%;">
                                            <span class="fw-bold text-dark small d-block text-truncate">@doc.FileName</span>
                                            <small class="text-muted" style="font-size: 11px;">⏱️ @doc.UploadedDate.ToString("dd.MM.yyyy HH:mm")</small>
                                        </div>
                                        <a href="@doc.FilePath" target="_blank" class="btn btn-sm btn-outline-dark" title="Görüntüle"><i class="bi bi-box-arrow-up-right"></i> Aç</a>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button type="button" data-id="@doc.Id" class="btn btn-sm btn-outline-primary flex-fill btn-summary fw-bold"><i class="bi bi-card-text"></i> Özetle</button>
                                        <button type="button" data-id="@doc.Id" class="btn btn-sm btn-outline-success flex-fill btn-quiz fw-bold"><i class="bi bi-ui-checks"></i> Quiz Yap</button>

                                        @if (User.IsInRole("Teacher"))
                                        {
                                            <form asp-action="DeleteDocument" method="post" class="d-inline" onsubmit="return confirm('Bu dökümanı silmek istediğinize emin misiniz?');">
                                                <input type="hidden" name="id" value="@doc.Id" />
                                                <input type="hidden" name="courseId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-sm btn-danger" title="Sil"><i class="bi bi-trash"></i></button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4 mb-0 small">Bu kursa henüz harici döküman yüklenmemiş.</p>
                    }
                </div>
            </div>

            @if (User.IsInRole("Teacher"))
            {
                <div class="card mb-4">
                    <div class="card-header bg-white fw-bold py-3">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-cloud-arrow-up text-primary"></i> Bilgi Havuzuna Doküman Ekle</h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="UploadDocument" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="courseId" value="@Model.Id" />
                            <div class="mb-3">
                                <label class="form-label small text-muted">Sistem otomatik olarak metin analizi yapıp vektör indeksleme yapacaktır. (.pdf, .txt)</label>
                                <input type="file" name="file" class="form-control form-control-sm" accept=".pdf,.txt" required />
                            </div>
                            <button type="submit" class="btn btn-warning btn-sm w-100 fw-bold shadow-sm">Yükle ve İndeksle</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Kodu Değişmedi, sadece aşağıda JS güncellendi -->
<div class="modal fade" id="quizModal" tabindex="-1" aria-labelledby="quizModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content quiz-modal">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold" id="quizModalLabel">Doküman Quiz</h5>
                    <small class="text-muted" id="quizProgressText">Hazırlanıyor...</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div id="quizSetup" class="quiz-setup mb-3">
                    <div class="row g-2 align-items-end">
                        <div class="col-sm-4">
                            <label class="form-label small fw-bold text-secondary">Soru Sayısı</label>
                            <select class="form-select form-select-sm" id="quizQuestionCount">
                                <option value="3">3 soru</option>
                                <option value="5" selected>5 soru</option>
                                <option value="10">10 soru</option>
                            </select>
                        </div>
                        <div class="col-sm-5">
                            <label class="form-label small fw-bold text-secondary">Zorluk</label>
                            <select class="form-select form-select-sm" id="quizDifficulty">
                                <option value="mixed" selected>Karma</option>
                                <option value="easy">Kolay</option>
                                <option value="medium">Orta</option>
                                <option value="hard">Zor</option>
                            </select>
                        </div>
                        <div class="col-sm-3">
                            <button type="button" class="btn btn-primary btn-sm w-100" id="quizStartBtn">Başlat</button>
                        </div>
                    </div>
                </div>

                <div class="progress quiz-progress mb-3" role="progressbar">
                    <div class="progress-bar" id="quizProgressBar" style="width: 0%"></div>
                </div>

                <div id="quizLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-3 mb-0">Seçili yapay zeka modeli quizi hazırlıyor...</p>
                </div>

                <div id="quizQuestionArea" class="d-none">
                    <div class="quiz-meta mb-3" id="quizMeta"></div>
                    <h5 class="quiz-question" id="quizQuestionText"></h5>
                    <div id="quizOptions" class="quiz-options"></div>
                    <div id="quizFeedback" class="quiz-feedback d-none"></div>
                </div>

                <div id="quizResultArea" class="d-none text-center py-4">
                    <div class="quiz-score" id="quizScoreText"></div>
                    <p class="text-muted mb-3" id="quizScoreDetail"></p>
                    <div id="quizReview" class="text-start"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary" id="quizNextBtn" disabled>Sonraki</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            var quizState = {
                questions: [],
                currentIndex: 0,
                answers: [],
                selectedIndex: null,
                documentId: null
            };
            var quizModal = new bootstrap.Modal(document.getElementById("quizModal"));

            // Gizli Quiz butonunu yönetmek için bir değişken
            var currentSummaryDocId = null;

            // 1. RAG Soru Sorma (Form içinde modelName zaten otomatik serialize ediliyor!)
            $("#askAiForm").submit(function (e) {
                e.preventDefault();
                var btn = $("#btnAskAi");
                var container = $("#aiResponseContainer");
                var txt = $("#aiResponseText");

                btn.prop("disabled", true).text("Analiz Ediliyor...");
                container.removeClass("d-none");
                txt.html("<span class='text-muted italic'>Yapay zeka asistanı yanıt hazırlıyor...</span>");
                $(".btn-quiz-from-summary").hide();

                $.ajax({
                    url: '@Url.Action("AskAi", "Course")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (data) {
                        if (data.success) {
                            txt.text(data.response);
                        } else {
                            txt.html("<span class='text-danger fw-bold'>⚠️ Başarısız: " + data.response + "</span>");
                        }
                    },
                    error: function () {
                        txt.html("<span class='text-danger'>Ağ hatası!</span>");
                    },
                    complete: function () {
                        btn.prop("disabled", false).text("Soruyu Sor");
                    }
                });
            });

            // 2. Özetleme İşlemi (Model parametresi AJAX'a eklendi)
            $(".btn-summary").click(function () {
                var docId = $(this).data("id");
                currentSummaryDocId = docId; // Quiz'e çevir butonu için hafızada tut
                var courseId = '@Model.Id';
                var selectedModel = $("#aiModelSelect").val(); // Dinamik seçimi al

                // Formdaki select'i özetlenen dökümanla eşle (kullanıcı dostu)
                $("#documentIdSelect").val(docId);

                var container = $("#aiResponseContainer");
                var txt = $("#aiResponseText");

                container.removeClass("d-none");
                $(".btn-quiz-from-summary").hide(); // Önce gizle
                $('html, body').animate({ scrollTop: container.offset().top - 100 }, 400);
                txt.html("<span class='text-muted italic'>Özet çıkartılıyor...</span>");

                $.ajax({
                    url: '@Url.Action("DocumentSummary", "Course")',
                    type: 'GET',
                    data: { courseId: courseId, documentId: docId, modelName: selectedModel }, // model gönderiliyor!
                    success: function (data) {
                        if (data.success) {
                            txt.text(data.response);
                            $(".btn-quiz-from-summary").fadeIn(); // Özeti aldıktan sonra Quiz butonunu göster
                        } else {
                            txt.html("<span class='text-danger fw-bold'>⚠️ " + data.response + "</span>");
                        }
                    },
                    error: function () {
                        txt.html("<span class='text-danger'>Hata meydana geldi.</span>");
                    }
                });
            });

            // 3. Özet sonrası çıkan "Bu Özeti Quiz'e Çevir" Butonu
            $(".btn-quiz-from-summary").click(function() {
                if(currentSummaryDocId) {
                    resetQuizModal();
                    quizState.documentId = currentSummaryDocId;
                    quizModal.show();
                }
            });

            // 4. Standart Quiz Üretme Akışı
            $(".btn-quiz").click(function () {
                var docId = $(this).data("id");
                resetQuizModal();
                quizState.documentId = docId;
                quizModal.show();
            });

            $("#quizStartBtn").click(function () {
                loadQuiz();
            });

            $("#quizNextBtn").click(function () {
                if (quizState.selectedIndex === null) return;
                quizState.answers[quizState.currentIndex] = quizState.selectedIndex;
                if (quizState.currentIndex >= quizState.questions.length - 1) {
                    renderQuizResult();
                    return;
                }
                quizState.currentIndex++;
                renderQuizQuestion();
            });

            function resetQuizModal() {
                quizState = { questions: [], currentIndex: 0, answers: [], selectedIndex: null, documentId: quizState.documentId };
                $("#quizProgressText").text("Ayarları seç");
                $("#quizProgressBar").css("width", "0%");
                $("#quizSetup").removeClass("d-none");
                $("#quizLoading").addClass("d-none");
                $("#quizQuestionArea").addClass("d-none");
                $("#quizResultArea").addClass("d-none");
                $("#quizNextBtn").prop("disabled", true).text("Sonraki").removeClass("btn-success").addClass("btn-primary");
            }

            // Quiz Yüklerken Model Parametresini Ekledik
            function loadQuiz() {
                var courseId = '@Model.Id';
                var questionCount = $("#quizQuestionCount").val();
                var difficulty = $("#quizDifficulty").val();
                var selectedModel = $("#aiModelSelect").val(); // Dinamik seçimi al

                $("#quizSetup").addClass("d-none");
                $("#quizLoading").removeClass("d-none");
                $("#quizStartBtn").prop("disabled", true);

                $.ajax({
                    url: '@Url.Action("DocumentQuizSession", "Course")',
                    type: 'GET',
                    // modelName eklendi!
                    data: { courseId: courseId, documentId: quizState.documentId, questionCount: questionCount, difficulty: difficulty, modelName: selectedModel },
                    success: function (data) {
                        if (data.success && data.questions && data.questions.length > 0) {
                            quizState.questions = data.questions;
                            quizState.answers = new Array(data.questions.length).fill(null);
                            quizState.currentIndex = 0;
                            renderQuizQuestion();
                        } else {
                            showQuizError(data.response || "Quiz hazırlanamadı.");
                        }
                    },
                    error: function () {
                        showQuizError("Teknik hata meydana geldi.");
                    }
                });
            }

            // --- Diğer standart render fonksiyonları (değiştirilmedi, yer tasarrufu için özetlendi) ---
            function renderQuizQuestion() {
                var question = quizState.questions[quizState.currentIndex];
                quizState.selectedIndex = quizState.answers[quizState.currentIndex];
                var progress = ((quizState.currentIndex + 1) / quizState.questions.length) * 100;

                $("#quizLoading").addClass("d-none");
                $("#quizResultArea").addClass("d-none");
                $("#quizQuestionArea").removeClass("d-none");
                $("#quizProgressText").text("Soru " + (quizState.currentIndex + 1) + " / " + quizState.questions.length);
                $("#quizProgressBar").css("width", progress + "%");
                $("#quizQuestionText").text(question.question);
                $("#quizNextBtn")
                    .prop("disabled", quizState.selectedIndex === null)
                    .text(quizState.currentIndex === quizState.questions.length - 1 ? "Bitir" : "Sonraki");

                var optionsHtml = "";
                question.options.forEach(function (option, index) {
                    var selectedClass = quizState.selectedIndex === index ? " selected" : "";
                    optionsHtml += "<button type='button' class='quiz-option" + selectedClass + "' data-index='" + index + "'><span>" + String.fromCharCode(65 + index) + "</span><strong>" + escapeHtml(option) + "</strong></button>";
                });
                $("#quizOptions").html(optionsHtml);
            }

            $(document).on("click", ".quiz-option", function () {
                quizState.selectedIndex = parseInt($(this).data("index"));
                $(".quiz-option").removeClass("selected");
                $(this).addClass("selected");
                $("#quizNextBtn").prop("disabled", false);
            });

            function renderQuizResult() {
                var score = 0;
                var reviewHtml = "";
                quizState.questions.forEach(function (question, index) {
                    var userAnswer = quizState.answers[index];
                    var isCorrect = userAnswer === question.correctIndex;
                    if (isCorrect) score++;

                    reviewHtml += "<div class='quiz-review-item " + (isCorrect ? "correct" : "incorrect") + "'>";
                    reviewHtml += "<strong>" + (index + 1) + ". " + escapeHtml(question.question) + "</strong>";
                    reviewHtml += "<p class='mb-1'>Cevabın: " + answerLabel(question, userAnswer) + "</p>";
                    reviewHtml += "<p class='mb-1'>Doğru cevap: " + answerLabel(question, question.correctIndex) + "</p>";
                    reviewHtml += "</div>";
                });

                $("#quizQuestionArea").addClass("d-none");
                $("#quizResultArea").removeClass("d-none");
                $("#quizProgressBar").css("width", "100%");
                $("#quizScoreText").text(score + " / " + quizState.questions.length);
                $("#quizReview").html(reviewHtml);
                $("#quizNextBtn").prop("disabled", true).text("Tamamlandı");
            }

            function showQuizError(message) {
                $("#quizLoading").addClass("d-none");
                $("#quizResultArea").removeClass("d-none");
                $("#quizScoreDetail").text(message);
            }

            function answerLabel(question, index) {
                if (index === null || index === undefined) return "Boş";
                return String.fromCharCode(65 + index) + ") " + escapeHtml(question.options[index]);
            }

            function escapeHtml(value) {
                return $("<div>").text(value || "").html();
            }
        });
    </script>
}