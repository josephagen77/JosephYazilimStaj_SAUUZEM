@model IEnumerable<MiniLms.Models.AiProvider>

@{
    ViewData["Title"] = "AI Sağlayıcılarını Yönet";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold"><i class="bi bi-robot text-danger"></i> AI Sağlayıcı Yönetimi</h3>
        <button class="btn btn-success fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addProviderModal">
            <i class="bi bi-plus-lg"></i> Yeni Sağlayıcı Ekle
        </button>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Görünen Ad</th>
                        <th>Sistem Kodu</th>
                        <th>Global API Anahtarı</th>
                        <th>Durum</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">Sistemde henüz kayıtlı bir yapay zeka bulunmuyor.</td></tr>
                    }
                    @foreach (var provider in Model)
                    {
                        <tr class="align-middle">
                            <td class="fw-bold text-muted">@provider.Id</td>
                            <td class="fw-bold">@provider.Name</td>
                            <td><span class="badge bg-secondary">@provider.ProviderKey</span></td>
                            <td>
                                @if (string.IsNullOrEmpty(provider.GlobalApiKey))
                                {
                                    <span class="text-muted small fst-italic">Yok</span>
                                }
                                else
                                {
                                    <span class="text-success"><i class="bi bi-key-fill"></i> Sistem Sağlıyor</span>
                                }
                            </td>
                            <td>
                                @if (provider.IsActive)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Pasif</span>
                                }
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-primary fw-bold me-1" data-bs-toggle="modal" data-bs-target="#editProviderModal-@provider.Id">
                                    <i class="bi bi-pencil-square"></i> Düzenle
                                </button>

                                <form asp-action="ToggleAiProvider" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@provider.Id" />
                                    @if (provider.IsActive)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger fw-bold" onclick="return confirm('Bu sağlayıcıyı kapatırsanız hiçbir öğrenci kullanamaz. Emin misiniz?');">
                                            Kapat
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success fw-bold">Aç</button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- 🎯 MODALLAR BURAYA TAŞINDI -->
@foreach (var provider in Model)
{
    <div class="modal fade" id="editProviderModal-@provider.Id" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="EditAiProvider" method="post">
                    <input type="hidden" name="id" value="@provider.Id" />
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title fw-bold">Sağlayıcıyı Düzenle</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body bg-light text-start">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Görünen Ad</label>
                            <input type="text" name="name" class="form-control" value="@provider.Name" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Sistem Kodu</label>
                            <input type="text" name="providerKey" class="form-control" value="@provider.ProviderKey" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-success">Global API Anahtarı</label>
                            <input type="text" name="globalApiKey" class="form-control" value="@provider.GlobalApiKey" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-primary fw-bold">Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Yeni Sağlayıcı Ekleme Modalı -->
<div class="modal fade" id="addProviderModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateAiProvider" method="post">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold">Yeni AI Sağlayıcı Ekle</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body bg-light">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Görünen Ad</label>
                        <input type="text" name="name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Sistem Kodu</label>
                        <input type="text" name="providerKey" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-success">Global API Anahtarı</label>
                        <input type="text" name="globalApiKey" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-success fw-bold">Sisteme Ekle</button>
                </div>
            </form>
        </div>
    </div>
</div>