@{
    ViewData["Title"] = "Sistem Yöneticisi Paneli";
}

<div class="container mt-4">
    <h2 class="fw-bold text-danger mb-4"><i class="bi bi-shield-lock"></i> Sistem Yöneticisi Paneli</h2>

    <div class="row g-4">
        <!-- Kullanıcı Yönetimi -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-top border-4 border-success h-100">
                <div class="card-body text-center p-4">
                    <i class="bi bi-people-fill text-success mb-3" style="font-size: 3rem;"></i>
                    <h4 class="fw-bold">Kullanıcılar</h4>
                    <p class="text-muted small">Öğretmen, Öğrenci ve Program Yöneticilerini yönetin.</p>
                    <h3 class="fw-bold text-success mb-3">@ViewBag.TotalUsers <span class="fs-6 text-muted fw-normal">Kişi</span></h3>
                    <a asp-action="Users" class="btn btn-outline-success w-100 fw-bold">Yönet</a>
                </div>
            </div>
        </div>

        <!-- Departman Yönetimi -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-top border-4 border-primary h-100">
                <div class="card-body text-center p-4">
                    <i class="bi bi-building text-primary mb-3" style="font-size: 3rem;"></i>
                    <h4 class="fw-bold">Departmanlar</h4>
                    <p class="text-muted small">Fakülte ve bölümleri oluşturun, Bölüm Başkanı atayın.</p>
                    <h3 class="fw-bold text-primary mb-3">@ViewBag.TotalDepartments <span class="fs-6 text-muted fw-normal">Bölüm</span></h3>
                    <a asp-action="Departments" class="btn btn-outline-primary w-100 fw-bold">Yönet</a>
                </div>
            </div>
        </div>

        <!-- Ders Yönetimi -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-top border-4 border-warning h-100">
                <div class="card-body text-center p-4">
                    <i class="bi bi-book-fill text-warning mb-3" style="font-size: 3rem;"></i>
                    <h4 class="fw-bold">Dersler</h4>
                    <p class="text-muted small">Tüm fakülte derslerini ve müfredatları yönetin.</p>
                    <h3 class="fw-bold text-warning mb-3">@ViewBag.TotalCourses <span class="fs-6 text-muted fw-normal">Ders</span></h3>
                    <a asp-action="Courses" class="btn btn-outline-warning w-100 fw-bold">Yönet</a>
                </div>
            </div>
        </div>

        <!-- AI Yönetimi -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-top border-4 border-danger h-100">
                <div class="card-body text-center p-4">
                    <i class="bi bi-robot text-danger mb-3" style="font-size: 3rem;"></i>
                    <h4 class="fw-bold">AI Sağlayıcıları</h4>
                    <p class="text-muted small">Yapay zeka modellerini açın, kapatın veya düzenleyin.</p>
                    <h3 class="fw-bold text-danger mb-3">@ViewBag.TotalAiProviders <span class="fs-6 text-muted fw-normal">Model</span></h3>
                    <a asp-action="AiProviders" class="btn btn-outline-danger w-100 fw-bold">Yönet</a>
                </div>
            </div>
        </div>
    </div>
</div>