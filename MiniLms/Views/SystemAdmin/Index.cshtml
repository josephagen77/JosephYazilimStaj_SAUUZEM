@{
    ViewData["Title"] = "Sistem Yöneticisi Paneli";
}

<div class="container mt-4">
    <h2 class="fw-bold text-danger mb-4"><i class="bi bi-shield-lock"></i> Sistem Yöneticisi Paneli</h2>

    <div class="row g-4">
        <!-- AI Yönetim Kartı -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 border-top border-4 border-danger h-100">
                <div class="card-body text-center p-4">
                    <i class="bi bi-robot text-danger mb-3" style="font-size: 3rem;"></i>
                    <h4 class="fw-bold">AI Sağlayıcıları</h4>
                    <p class="text-muted small">Sistemdeki yapay zeka modellerini ekleyin, yönetin veya güvenlik amacıyla kapatın.</p>
                    <a asp-action="AiProviders" class="btn btn-outline-danger w-100 fw-bold">Yönet</a>
                </div>
            </div>
        </div>

        <!-- Departman Yönetim Kartı (Hazırlık) -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 border-top border-4 border-primary h-100 opacity-75">
                <div class="card-body text-center p-4">
                    <i class="bi bi-building text-primary mb-3" style="font-size: 3rem;"></i>
                    <h4 class="fw-bold">Departmanlar</h4>
                    <p class="text-muted small">Fakülte ve bölümleri oluşturun, Program Yöneticilerini (Dekan/Bölüm Başkanı) atayın.</p>
                    <button class="btn btn-outline-primary w-100 fw-bold" disabled>Çok Yakında</button>
                </div>
            </div>
        </div>
    </div>
</div>