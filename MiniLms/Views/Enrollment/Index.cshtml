@model IEnumerable<MiniLms.Models.Enrollment>
@{
    ViewData["Title"] = "Ders Kayıt Listesi";
    var courses = ViewBag.Courses as IEnumerable<MiniLms.Models.Course>;
}

<div>
    <section class="page-hero">
        <div class="d-flex align-items-center gap-3">
            <span class="hero-icon"><i class="bi bi-person-lines-fill"></i></span>
            <div>
                <h1 class="page-title">Ders Kayıt Yönetimi</h1>
                <p class="page-subtitle">Sınıf mevcutlarını görün veya bireysel kayıt işlemlerini takip edin.</p>
            </div>
        </div>
        <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> Bireysel Ders Kaydı Yap</a>
    </section>

    <!-- 🎯 YENİ: Derslere Göre Sınıf Mevcutları (Öğretmen Görünümü) -->
    <h3 class="section-title mb-3">Sınıf Listeleri ve Mevcutlar</h3>
    <div class="card table-card mb-5">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-primary">
                    <tr>
                        <th>Ders Kodu</th>
                        <th>Ders Adı</th>
                        <th class="text-center">Kayıtlı Öğrenci Sayısı</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (courses != null && courses.Any())
                    {
                        @foreach (var course in courses)
                        {
                            var studentCount = Model.Count(e => e.CourseId == course.Id);
                            <tr>
                                <td class="fw-bold text-danger">@course.CourseCode</td>
                                <td class="fw-bold">@course.Title</td>
                                <td class="text-center">
                                    <span class="badge @(studentCount > 0 ? "bg-success" : "bg-secondary") fs-6">
                                        <i class="bi bi-people-fill"></i> @studentCount Öğrenci
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Manage" asp-route-id="@course.Id" class="btn btn-primary btn-sm">
                                        <i class="bi bi-gear"></i> Sınıfı Yönet
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="text-center py-3 text-muted">Sistemde kayıtlı ders bulunamadı.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- MEVCUT: Orijinal Tüm Kayıtlar Listesi (Log/Geçmiş Görüntüleme) -->
    <h3 class="section-title mb-3">Son Kayıt Hareketleri (Tüm Liste)</h3>
    <div class="card table-card">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Öğrenci Numarası</th>
                        <th>Öğrenci Adı Soyadı</th>
                        <th>Ders Kodu</th>
                        <th>Ders Adı</th>
                        <th>Kayıt Tarihi</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Sistemde henüz ders kaydı yapmış bir öğrenci bulunmamaktadır.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.OrderByDescending(e => e.EnrollmentDate))
                        {
                            <tr>
                                <td class="fw-bold text-secondary">@item.Student?.StudentNumber</td>
                                <td>@item.Student?.FirstName @item.Student?.LastName</td>
                                <td class="fw-bold text-danger">@item.Course?.CourseCode</td>
                                <td>@item.Course?.Title</td>
                                <td>@item.EnrollmentDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-center">
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Bu kaydı silmek istediğinize emin misiniz?');">
                                            <i class="bi bi-trash"></i> Kaydı Sil
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>