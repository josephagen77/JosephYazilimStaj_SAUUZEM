@model MiniLms.ViewModels.StudentCourseListViewModel

@{
    ViewData["Title"] = "Derslerim";
}

<section class="page-hero">
    <div class="d-flex align-items-center gap-3">
        <span class="hero-icon"><i class="bi bi-journal-check"></i></span>
        <div>
            <h1 class="page-title">Derslerim</h1>
            <p class="page-subtitle">Kayıtlı olduğunuz dersleri görüntüleyin ve detaylarına erişin.</p>
        </div>
    </div>
</section>

<div class="mb-4">
    <h2 class="section-title">Kayıtlı Olduğum Dersler</h2>
    <div class="card table-card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Ders Kodu</th>
                        <th>Ders Adı</th>
                        <th>Kredi</th>
                        <th>Kayıt Tarihi</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Enrollments.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Henüz kayıtlı olduğunuz bir ders yok. Lütfen öğretmeninizle iletişime geçin.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var enrollment in Model.Enrollments)
                        {
                            <tr>
                                <td class="fw-bold text-danger">@enrollment.Course?.CourseCode</td>
                                <td>@enrollment.Course?.Title</td>
                                <td><span class="badge bg-secondary">@enrollment.Course?.Credits AKTS</span></td>
                                <td>@enrollment.EnrollmentDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-controller="Course" asp-action="Details" asp-route-id="@enrollment.CourseId" class="btn btn-info text-white">
                                            <i class="bi bi-eye"></i> Detay
                                        </a>
                                        <form asp-action="Unenroll" method="post" class="d-inline">
                                            <input type="hidden" name="courseId" value="@enrollment.CourseId" />
                                            <button type="submit" class="btn btn-danger" onclick="return confirm('Bu dersten çıkmak istediğinize emin misiniz?');">
                                                <i class="bi bi-x-circle"></i> Kaydı Sil
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>